# 复制为 .env 后按需修改；deploy.sh 会用环境变量覆盖同名项
REGISTRY=ghcr.io
IMAGE_NAMESPACE=your-github-org
IMAGE_TAG=latest

# 对外端口
HTTP_PORT=80

# 时区与 JVM 参数
TZ=Asia/Shanghai
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+UseSerialGC

# GRIB2 数据文件：留空表示使用镜像内置的文件；
# 指向宿主机目录时会覆盖容器内 /app/data 下的文件
GRIB_DATA_DIR=
GRIB_FILE=/app/data/gfs_20260701_00z_f000.grib2
