# 复制为 .env 后按需修改；deploy.sh 会用环境变量覆盖同名项
REGISTRY=ghcr.io
IMAGE_NAMESPACE=your-github-org
IMAGE_TAG=latest

# 对外端口（Snowy 前端默认 81）
HTTP_PORT=81

# 时区与 JVM 参数
TZ=Asia/Shanghai

# 数据库
MYSQL_ROOT_PASSWORD=12345678
MYSQL_DATABASE=snowy

# 对外访问地址：后端会据此生成前后端跳转链接
PUBLIC_FRONT_URL=http://localhost:81
PUBLIC_BACKEND_URL=http://localhost:81/api
